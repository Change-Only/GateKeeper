# ============================================================
# GateKeeper 部署环境变量模板
# 使用：复制本文件为 .env（.gitignore 已忽略，不会入库），填入真实值
#   cp .env.example .env
# 生成随机密钥：openssl rand -base64 32
# ============================================================

# ---------- 【必填】安全密钥（启动自检强校验，配置不当拒绝启动） ----------
# JWT 签名密钥：至少 32 位随机串，泄露 = 任何人可伪造管理员令牌
GATEKEEPER_JWT_SECRET=
# 数据库密钥加密密钥（AES-256）：至少 32 位随机串，泄露 = 落库的 AppSecret 可被解密
GATEKEEPER_AES_KEY=
# MySQL root 密码（compose 会用它初始化数据库）
GATEKEEPER_DB_PASSWORD=

# ---------- 【选填】部署参数 ----------
# 数据库名（默认 gatekeeper）
GATEKEEPER_DB_NAME=gatekeeper
# 数据库用户名（默认 root）
GATEKEEPER_DB_USERNAME=root
# Redis 访问密码（compose 用它启动 redis-server --requirepass）
# 不填则使用内置默认口令，取值见 README「默认账号与密钥」；
# 生产环境务必改成随机口令：openssl rand -base64 24
GATEKEEPER_REDIS_PASSWORD=
# 允许跨域的前端来源（生产改成实际域名，逗号分隔）
GATEKEEPER_CORS_ORIGINS=http://localhost:8081
